<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="coaxial_uav">
    <self_collide>false</self_collide>

    <link name="base_link">
      <inertial>
        <mass>8.1</mass>
        <inertia>
          <ixx>0.18</ixx>
          <iyy>0.34</iyy>
          <izz>0.28</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="fuselage_collision">
        <geometry>
          <box><size>0.50 0.28 0.18</size></box>
        </geometry>
      </collision>
      <!-- Visual-only airframe. Collision and inertia stay deliberately simple. -->
      <visual name="fuselage_shell">
        <pose>0.015 0 0.015 0 0 0</pose>
        <geometry><ellipsoid><radii>0.30 0.17 0.13</radii></ellipsoid></geometry>
        <material>
          <ambient>0.055 0.065 0.075 1</ambient>
          <diffuse>0.10 0.12 0.14 1</diffuse>
          <specular>0.32 0.34 0.36 1</specular>
        </material>
      </visual>
      <visual name="lower_equipment_pod">
        <pose>-0.025 0 -0.065 0 0 0</pose>
        <geometry><ellipsoid><radii>0.235 0.135 0.080</radii></ellipsoid></geometry>
        <material>
          <ambient>0.12 0.14 0.16 1</ambient>
          <diffuse>0.19 0.22 0.24 1</diffuse>
          <specular>0.26 0.28 0.30 1</specular>
        </material>
      </visual>
      <visual name="canopy">
        <pose>0.105 0 0.105 0 0 0</pose>
        <geometry><ellipsoid><radii>0.155 0.115 0.062</radii></ellipsoid></geometry>
        <material>
          <ambient>0.015 0.055 0.075 1</ambient>
          <diffuse>0.025 0.12 0.16 1</diffuse>
          <specular>0.70 0.78 0.82 1</specular>
        </material>
      </visual>
      <visual name="rear_service_deck">
        <pose>-0.175 0 0.105 0 0 0</pose>
        <geometry><box><size>0.145 0.165 0.030</size></box></geometry>
        <material>
          <ambient>0.16 0.18 0.19 1</ambient>
          <diffuse>0.25 0.28 0.30 1</diffuse>
          <specular>0.20 0.22 0.24 1</specular>
        </material>
      </visual>

      <!-- Coaxial mast, motor fairing and direction markings. -->
      <visual name="mast_fairing">
        <pose>0 0 0.170 0 0 0</pose>
        <geometry><cylinder><radius>0.068</radius><length>0.250</length></cylinder></geometry>
        <material>
          <ambient>0.11 0.12 0.13 1</ambient>
          <diffuse>0.19 0.20 0.22 1</diffuse>
          <specular>0.42 0.44 0.46 1</specular>
        </material>
      </visual>
      <visual name="rotor_mast">
        <pose>0 0 0.180 0 0 0</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.360</length></cylinder></geometry>
        <material>
          <ambient>0.24 0.25 0.26 1</ambient>
          <diffuse>0.42 0.44 0.46 1</diffuse>
          <specular>0.75 0.75 0.75 1</specular>
        </material>
      </visual>
      <visual name="nose_chevron_left">
        <pose>0.205 0.040 0.132 0 0 0.35</pose>
        <geometry><box><size>0.125 0.022 0.012</size></box></geometry>
        <material><ambient>0.95 0.58 0.02 1</ambient><diffuse>1.0 0.68 0.04 1</diffuse></material>
      </visual>
      <visual name="nose_chevron_right">
        <pose>0.205 -0.040 0.132 0 0 -0.35</pose>
        <geometry><box><size>0.125 0.022 0.012</size></box></geometry>
        <material><ambient>0.95 0.58 0.02 1</ambient><diffuse>1.0 0.68 0.04 1</diffuse></material>
      </visual>

      <!-- GNSS, forward camera and navigation lights make orientation readable. -->
      <visual name="gnss_antenna">
        <pose>-0.185 0 0.148 0 0 0</pose>
        <geometry><ellipsoid><radii>0.050 0.050 0.024</radii></ellipsoid></geometry>
        <material><ambient>0.72 0.74 0.75 1</ambient><diffuse>0.88 0.90 0.91 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
      </visual>
      <visual name="camera_housing">
        <pose>0.292 0 -0.050 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.050</radius><length>0.074</length></cylinder></geometry>
        <material><ambient>0.08 0.09 0.10 1</ambient><diffuse>0.14 0.15 0.17 1</diffuse><specular>0.36 0.38 0.40 1</specular></material>
      </visual>
      <visual name="camera_lens">
        <pose>0.332 0 -0.050 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.031</radius><length>0.010</length></cylinder></geometry>
        <material><ambient>0.005 0.018 0.025 1</ambient><diffuse>0.01 0.035 0.05 1</diffuse><specular>0.80 0.88 0.92 1</specular></material>
      </visual>
      <visual name="port_navigation_light">
        <pose>0.035 0.171 0.045 0 0 0</pose>
        <geometry><sphere><radius>0.018</radius></sphere></geometry>
        <material><ambient>0.75 0.01 0.01 1</ambient><diffuse>1.0 0.02 0.02 1</diffuse><emissive>0.65 0.0 0.0 1</emissive></material>
      </visual>
      <visual name="starboard_navigation_light">
        <pose>0.035 -0.171 0.045 0 0 0</pose>
        <geometry><sphere><radius>0.018</radius></sphere></geometry>
        <material><ambient>0.01 0.65 0.05 1</ambient><diffuse>0.02 1.0 0.08 1</diffuse><emissive>0.0 0.55 0.02 1</emissive></material>
      </visual>
      <visual name="rear_status_light">
        <pose>-0.286 0 0.055 0 0 0</pose>
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <material><ambient>0.95 0.45 0.0 1</ambient><diffuse>1.0 0.62 0.02 1</diffuse><emissive>0.55 0.20 0.0 1</emissive></material>
      </visual>

      <!-- Two cross beams and four short pylons connect the watertight floats. -->
      <visual name="front_float_crossbeam">
        <pose>0.190 0 -0.115 0 0 0</pose>
        <geometry><box><size>0.038 0.690 0.035</size></box></geometry>
        <material><ambient>0.12 0.13 0.14 1</ambient><diffuse>0.21 0.23 0.25 1</diffuse><specular>0.35 0.36 0.37 1</specular></material>
      </visual>
      <visual name="rear_float_crossbeam">
        <pose>-0.190 0 -0.115 0 0 0</pose>
        <geometry><box><size>0.038 0.690 0.035</size></box></geometry>
        <material><ambient>0.12 0.13 0.14 1</ambient><diffuse>0.21 0.23 0.25 1</diffuse><specular>0.35 0.36 0.37 1</specular></material>
      </visual>
      <visual name="front_left_float_pylon">
        <pose>0.190 0.340 -0.160 0 0 0</pose>
        <geometry><box><size>0.042 0.042 0.100</size></box></geometry>
        <material><diffuse>0.16 0.18 0.20 1</diffuse><specular>0.30 0.32 0.34 1</specular></material>
      </visual>
      <visual name="front_right_float_pylon">
        <pose>0.190 -0.340 -0.160 0 0 0</pose>
        <geometry><box><size>0.042 0.042 0.100</size></box></geometry>
        <material><diffuse>0.16 0.18 0.20 1</diffuse><specular>0.30 0.32 0.34 1</specular></material>
      </visual>
      <visual name="rear_left_float_pylon">
        <pose>-0.190 0.340 -0.160 0 0 0</pose>
        <geometry><box><size>0.042 0.042 0.100</size></box></geometry>
        <material><diffuse>0.16 0.18 0.20 1</diffuse><specular>0.30 0.32 0.34 1</specular></material>
      </visual>
      <visual name="rear_right_float_pylon">
        <pose>-0.190 -0.340 -0.160 0 0 0</pose>
        <geometry><box><size>0.042 0.042 0.100</size></box></geometry>
        <material><diffuse>0.16 0.18 0.20 1</diffuse><specular>0.30 0.32 0.34 1</specular></material>
      </visual>

      <!-- Simplified twin floats: collision/contact only, not a fluid model. -->
      <collision name="float_left_collision">
        <pose>0 0.34 -0.24 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>1.10</length></cylinder></geometry>
        <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
      </collision>
      <visual name="float_left_shell">
        <pose>0 0.34 -0.24 0 1.5708 0</pose>
        <geometry><capsule><radius>0.09</radius><length>0.92</length></capsule></geometry>
        <material><ambient>0.67 0.70 0.72 1</ambient><diffuse>0.88 0.91 0.92 1</diffuse><specular>0.48 0.50 0.52 1</specular></material>
      </visual>
      <visual name="float_left_keel">
        <pose>0 0.34 -0.283 0 0 0</pose>
        <geometry><ellipsoid><radii>0.48 0.082 0.038</radii></ellipsoid></geometry>
        <material><ambient>0.12 0.15 0.17 1</ambient><diffuse>0.20 0.25 0.28 1</diffuse><specular>0.24 0.26 0.28 1</specular></material>
      </visual>
      <visual name="float_left_bow_mark">
        <pose>0.425 0.34 -0.180 0 0 0</pose>
        <geometry><box><size>0.115 0.105 0.018</size></box></geometry>
        <material><ambient>0.95 0.58 0.02 1</ambient><diffuse>1.0 0.68 0.04 1</diffuse></material>
      </visual>
      <collision name="float_right_collision">
        <pose>0 -0.34 -0.24 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>1.10</length></cylinder></geometry>
        <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
      </collision>
      <visual name="float_right_shell">
        <pose>0 -0.34 -0.24 0 1.5708 0</pose>
        <geometry><capsule><radius>0.09</radius><length>0.92</length></capsule></geometry>
        <material><ambient>0.67 0.70 0.72 1</ambient><diffuse>0.88 0.91 0.92 1</diffuse><specular>0.48 0.50 0.52 1</specular></material>
      </visual>
      <visual name="float_right_keel">
        <pose>0 -0.34 -0.283 0 0 0</pose>
        <geometry><ellipsoid><radii>0.48 0.082 0.038</radii></ellipsoid></geometry>
        <material><ambient>0.12 0.15 0.17 1</ambient><diffuse>0.20 0.25 0.28 1</diffuse><specular>0.24 0.26 0.28 1</specular></material>
      </visual>
      <visual name="float_right_bow_mark">
        <pose>0.425 -0.34 -0.180 0 0 0</pose>
        <geometry><box><size>0.115 0.105 0.018</size></box></geometry>
        <material><ambient>0.95 0.58 0.02 1</ambient><diffuse>1.0 0.68 0.04 1</diffuse></material>
      </visual>

      <sensor name="imu" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <topic>imu</topic>
      </sensor>
    </link>

    <link name="upper_rotor_link">
      <pose>0 0 0.295 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.005</ixx><iyy>0.005</iyy><izz>0.01</izz>
        </inertia>
      </inertial>
      <visual name="upper_rotor_blur">
        <geometry><cylinder><radius>0.775</radius><length>0.004</length></cylinder></geometry>
        <material><ambient>0.32 0.34 0.36 0.10</ambient><diffuse>0.48 0.50 0.52 0.10</diffuse></material>
        <transparency>0.90</transparency>
        <cast_shadows>false</cast_shadows>
      </visual>
      <visual name="upper_blade_forward">
        <pose>0.405 0 0.006 0 1.5708 0</pose>
        <geometry><capsule><radius>0.035</radius><length>0.670</length></capsule></geometry>
        <material><ambient>0.035 0.040 0.045 1</ambient><diffuse>0.075 0.085 0.095 1</diffuse><specular>0.28 0.30 0.32 1</specular></material>
      </visual>
      <visual name="upper_blade_aft">
        <pose>-0.405 0 0.006 0 1.5708 0</pose>
        <geometry><capsule><radius>0.035</radius><length>0.670</length></capsule></geometry>
        <material><ambient>0.035 0.040 0.045 1</ambient><diffuse>0.075 0.085 0.095 1</diffuse><specular>0.28 0.30 0.32 1</specular></material>
      </visual>
      <visual name="upper_tip_forward">
        <pose>0.720 0 0.012 0 0 0</pose>
        <geometry><box><size>0.105 0.072 0.014</size></box></geometry>
        <material><ambient>0.95 0.58 0.02 1</ambient><diffuse>1.0 0.68 0.04 1</diffuse></material>
      </visual>
      <visual name="upper_tip_aft">
        <pose>-0.720 0 0.012 0 0 0</pose>
        <geometry><box><size>0.105 0.072 0.014</size></box></geometry>
        <material><ambient>0.95 0.58 0.02 1</ambient><diffuse>1.0 0.68 0.04 1</diffuse></material>
      </visual>
      <visual name="upper_rotor_hub">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry><cylinder><radius>0.082</radius><length>0.060</length></cylinder></geometry>
        <material><ambient>0.22 0.23 0.24 1</ambient><diffuse>0.40 0.42 0.44 1</diffuse><specular>0.72 0.74 0.76 1</specular></material>
      </visual>
    </link>
    <joint name="upper_rotor_joint" type="revolute">
      <parent>base_link</parent>
      <child>upper_rotor_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.0001</damping></dynamics>
      </axis>
    </joint>

    <link name="lower_rotor_link">
      <pose>0 0 0.175 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.005</ixx><iyy>0.005</iyy><izz>0.01</izz>
        </inertia>
      </inertial>
      <visual name="lower_rotor_blur">
        <geometry><cylinder><radius>0.775</radius><length>0.004</length></cylinder></geometry>
        <material><ambient>0.32 0.34 0.36 0.08</ambient><diffuse>0.48 0.50 0.52 0.08</diffuse></material>
        <transparency>0.92</transparency>
        <cast_shadows>false</cast_shadows>
      </visual>
      <visual name="lower_blade_port">
        <pose>0 0.405 0.006 1.5708 0 0</pose>
        <geometry><capsule><radius>0.035</radius><length>0.670</length></capsule></geometry>
        <material><ambient>0.035 0.040 0.045 1</ambient><diffuse>0.075 0.085 0.095 1</diffuse><specular>0.28 0.30 0.32 1</specular></material>
      </visual>
      <visual name="lower_blade_starboard">
        <pose>0 -0.405 0.006 1.5708 0 0</pose>
        <geometry><capsule><radius>0.035</radius><length>0.670</length></capsule></geometry>
        <material><ambient>0.035 0.040 0.045 1</ambient><diffuse>0.075 0.085 0.095 1</diffuse><specular>0.28 0.30 0.32 1</specular></material>
      </visual>
      <visual name="lower_tip_port">
        <pose>0 0.720 0.012 0 0 0</pose>
        <geometry><box><size>0.072 0.105 0.014</size></box></geometry>
        <material><ambient>0.72 0.74 0.75 1</ambient><diffuse>0.90 0.92 0.93 1</diffuse></material>
      </visual>
      <visual name="lower_tip_starboard">
        <pose>0 -0.720 0.012 0 0 0</pose>
        <geometry><box><size>0.072 0.105 0.014</size></box></geometry>
        <material><ambient>0.72 0.74 0.75 1</ambient><diffuse>0.90 0.92 0.93 1</diffuse></material>
      </visual>
      <visual name="lower_rotor_hub">
        <pose>0 0 -0.018 0 0 0</pose>
        <geometry><cylinder><radius>0.076</radius><length>0.050</length></cylinder></geometry>
        <material><ambient>0.15 0.16 0.17 1</ambient><diffuse>0.27 0.29 0.31 1</diffuse><specular>0.58 0.60 0.62 1</specular></material>
      </visual>
    </link>
    <joint name="lower_rotor_joint" type="revolute">
      <parent>base_link</parent>
      <child>lower_rotor_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.0001</damping></dynamics>
      </axis>
    </joint>
  </model>
</sdf>
