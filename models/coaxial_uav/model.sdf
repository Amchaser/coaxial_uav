<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="coaxial_uav">
    <self_collide>false</self_collide>

    <link name="base_link">
      <inertial>
        <mass>8.2</mass>
        <inertia>
          <ixx>0.18</ixx>
          <iyy>0.34</iyy>
          <izz>0.28</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="fuselage_collision">
        <geometry>
          <box><size>0.50 0.28 0.18</size></box>
        </geometry>
      </collision>
      <visual name="fuselage_visual">
        <geometry>
          <box><size>0.50 0.28 0.18</size></box>
        </geometry>
        <material>
          <diffuse>0.12 0.12 0.15 1</diffuse>
          <specular>0.35 0.35 0.35 1</specular>
        </material>
      </visual>

      <!-- Simplified twin floats: collision/contact only, not a fluid model. -->
      <collision name="float_left_collision">
        <pose>0 0.34 -0.24 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>1.10</length></cylinder></geometry>
        <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
      </collision>
      <visual name="float_left_visual">
        <pose>0 0.34 -0.24 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>1.10</length></cylinder></geometry>
        <material><diffuse>0.92 0.92 0.95 1</diffuse></material>
      </visual>
      <collision name="float_right_collision">
        <pose>0 -0.34 -0.24 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>1.10</length></cylinder></geometry>
        <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
      </collision>
      <visual name="float_right_visual">
        <pose>0 -0.34 -0.24 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>1.10</length></cylinder></geometry>
        <material><diffuse>0.92 0.92 0.95 1</diffuse></material>
      </visual>

      <sensor name="imu" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <topic>imu</topic>
      </sensor>
    </link>

    <link name="upper_rotor_link">
      <pose>0 0 0.295 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.005</ixx><iyy>0.005</iyy><izz>0.01</izz>
        </inertia>
      </inertial>
      <visual name="upper_rotor_disk">
        <geometry><cylinder><radius>0.775</radius><length>0.012</length></cylinder></geometry>
        <material><diffuse>0.15 0.35 0.85 0.35</diffuse></material>
        <transparency>0.65</transparency>
      </visual>
    </link>
    <joint name="upper_rotor_joint" type="revolute">
      <parent>base_link</parent>
      <child>upper_rotor_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.0001</damping></dynamics>
      </axis>
    </joint>

    <link name="lower_rotor_link">
      <pose>0 0 0.175 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.005</ixx><iyy>0.005</iyy><izz>0.01</izz>
        </inertia>
      </inertial>
      <visual name="lower_rotor_disk">
        <geometry><cylinder><radius>0.775</radius><length>0.012</length></cylinder></geometry>
        <material><diffuse>0.85 0.30 0.12 0.35</diffuse></material>
        <transparency>0.65</transparency>
      </visual>
    </link>
    <joint name="lower_rotor_joint" type="revolute">
      <parent>base_link</parent>
      <child>lower_rotor_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.0001</damping></dynamics>
      </axis>
    </joint>
  </model>
</sdf>
