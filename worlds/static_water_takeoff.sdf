<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="static_water_takeoff">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- A static visual and collision plane, deliberately not a fluid simulation. -->
    <model name="static_water_surface">
      <static>true</static>
      <link name="link">
        <collision name="water_contact_plane">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>0.45</mu><mu2>0.45</mu2></ode></friction></surface>
        </collision>
        <visual name="water_visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.02 0.16 0.28 1</ambient>
            <diffuse>0.04 0.30 0.52 1</diffuse>
            <specular>0.45 0.55 0.65 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://coaxial_uav</uri>
      <pose>0 0 0.34 0 0 0</pose>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>coaxial_uav</robotNamespace>
        <jointName>upper_rotor_joint</jointName>
        <linkName>upper_rotor_link</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.075</timeConstantUp>
        <timeConstantDown>0.075</timeConstantDown>
        <maxRotVelocity>167.0</maxRotVelocity>
        <motorConstant>2.1610671e-3</motorConstant>
        <momentConstant>0.06478</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>0</actuator_number>
        <rotorDragCoefficient>0.0</rotorDragCoefficient>
        <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/upper</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>coaxial_uav</robotNamespace>
        <jointName>lower_rotor_joint</jointName>
        <linkName>lower_rotor_link</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.075</timeConstantUp>
        <timeConstantDown>0.075</timeConstantDown>
        <maxRotVelocity>167.0</maxRotVelocity>
        <motorConstant>2.1610671e-3</motorConstant>
        <momentConstant>0.06478</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>1</actuator_number>
        <rotorDragCoefficient>0.0</rotorDragCoefficient>
        <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/lower</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
    </include>
  </world>
</sdf>
