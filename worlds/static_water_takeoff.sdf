<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="static_water_takeoff">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- A static visual and collision plane, deliberately not a fluid simulation. -->
    <model name="static_water_surface">
      <static>true</static>
      <link name="link">
        <collision name="water_contact_plane">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>0.45</mu><mu2>0.45</mu2></ode></friction></surface>
        </collision>
        <visual name="water_visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.02 0.16 0.28 1</ambient>
            <diffuse>0.04 0.30 0.52 1</diffuse>
            <specular>0.45 0.55 0.65 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="landing_target_visual">
      <static>false</static>
      <pose>0 0 0.004 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
          </inertia>
        </inertial>
        <visual name="target_disc">
          <geometry><cylinder><radius>0.60</radius><length>0.006</length></cylinder></geometry>
          <material>
            <ambient>0.0 0.65 0.25 0.55</ambient>
            <diffuse>0.0 0.85 0.35 0.55</diffuse>
          </material>
          <transparency>0.45</transparency>
        </visual>
        <visual name="target_cross_x">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry><box><size>1.40 0.035 0.008</size></box></geometry>
          <material><diffuse>1.0 1.0 1.0 0.9</diffuse></material>
        </visual>
        <visual name="target_cross_y">
          <pose>0 0 0.007 0 0 0</pose>
          <geometry><box><size>0.035 1.40 0.008</size></box></geometry>
          <material><diffuse>1.0 1.0 1.0 0.9</diffuse></material>
        </visual>
      </link>
      <plugin filename="libMovingLandingTarget.so"
              name="coaxial_uav::MovingLandingTarget">
        <role>marker</role>
        <publish_status>false</publish_status>
        <platform_top_offset_m>0.20</platform_top_offset_m>
      </plugin>
    </model>

    <!-- Selectable solid landing deck. In water mode its plugin parks it
         below the world; in platform mode its top surface is 0.20 m above
         the configured water level and follows the landing target. -->
    <model name="landing_target_platform">
      <static>false</static>
      <pose>0 0 -3 0 0 0</pose>
      <link name="deck_link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial>
          <mass>20.0</mass>
          <inertia>
            <ixx>5.47</ixx><iyy>9.67</iyy><izz>14.60</izz>
          </inertia>
        </inertial>
        <collision name="deck_collision">
          <geometry><box><size>2.40 1.80 0.20</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1.2</mu><mu2>1.2</mu2></ode>
            </friction>
            <contact><ode><kp>1000000</kp><kd>100</kd></ode></contact>
          </surface>
        </collision>
        <visual name="deck_body">
          <geometry><box><size>2.40 1.80 0.20</size></box></geometry>
          <material>
            <ambient>0.12 0.15 0.17 1</ambient>
            <diffuse>0.19 0.23 0.25 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
        <visual name="landing_pad">
          <pose>0 0 0.103 0 0 0</pose>
          <geometry><cylinder><radius>0.68</radius><length>0.006</length></cylinder></geometry>
          <material>
            <ambient>0.07 0.43 0.27 1</ambient>
            <diffuse>0.10 0.62 0.38 1</diffuse>
          </material>
        </visual>
        <visual name="deck_center_x">
          <pose>0 0 0.108 0 0 0</pose>
          <geometry><box><size>1.20 0.045 0.008</size></box></geometry>
          <material><diffuse>0.94 0.96 0.94 1</diffuse></material>
        </visual>
        <visual name="deck_center_y">
          <pose>0 0 0.109 0 0 0</pose>
          <geometry><box><size>0.045 1.20 0.008</size></box></geometry>
          <material><diffuse>0.94 0.96 0.94 1</diffuse></material>
        </visual>
        <visual name="bow_marker">
          <pose>0.96 0 0.108 0 0 0</pose>
          <geometry><box><size>0.24 0.10 0.008</size></box></geometry>
          <material><diffuse>0.95 0.62 0.08 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="libMovingLandingTarget.so"
              name="coaxial_uav::MovingLandingTarget">
        <role>platform</role>
        <publish_status>true</publish_status>
        <platform_available>true</platform_available>
        <platform_top_offset_m>0.20</platform_top_offset_m>
        <platform_hidden_z_m>-3.0</platform_hidden_z_m>
        <platform_half_length_m>1.20</platform_half_length_m>
        <platform_half_width_m>0.90</platform_half_width_m>
        <platform_thickness_m>0.20</platform_thickness_m>
        <platform_edge_margin_m>0.03</platform_edge_margin_m>
        <contact_min_clearance_m>-0.08</contact_min_clearance_m>
        <contact_max_clearance_m>0.05</contact_max_clearance_m>
        <initial_overlap_min_clearance_m>-0.08</initial_overlap_min_clearance_m>
      </plugin>
    </model>

    <!-- Visual-only world origin reference; it has no collision or contact effect. -->
    <model name="world_origin_marker">
      <static>true</static>
      <pose>0 0 0.014 0 0 0</pose>
      <link name="link">
        <visual name="origin_frame_north">
          <pose>0 0.90 0 0 0 0</pose>
          <geometry><box><size>1.85 0.055 0.010</size></box></geometry>
          <material><ambient>1.0 0.68 0.02 1</ambient><diffuse>1.0 0.78 0.04 1</diffuse><emissive>0.18 0.08 0 1</emissive></material>
        </visual>
        <visual name="origin_frame_south">
          <pose>0 -0.90 0 0 0 0</pose>
          <geometry><box><size>1.85 0.055 0.010</size></box></geometry>
          <material><ambient>1.0 0.68 0.02 1</ambient><diffuse>1.0 0.78 0.04 1</diffuse><emissive>0.18 0.08 0 1</emissive></material>
        </visual>
        <visual name="origin_frame_east">
          <pose>0.90 0 0 0 0 0</pose>
          <geometry><box><size>0.055 1.85 0.010</size></box></geometry>
          <material><ambient>1.0 0.68 0.02 1</ambient><diffuse>1.0 0.78 0.04 1</diffuse><emissive>0.18 0.08 0 1</emissive></material>
        </visual>
        <visual name="origin_frame_west">
          <pose>-0.90 0 0 0 0 0</pose>
          <geometry><box><size>0.055 1.85 0.010</size></box></geometry>
          <material><ambient>1.0 0.68 0.02 1</ambient><diffuse>1.0 0.78 0.04 1</diffuse><emissive>0.18 0.08 0 1</emissive></material>
        </visual>
        <visual name="origin_x_axis">
          <pose>0.48 0 0.004 0 0 0</pose>
          <geometry><box><size>0.96 0.045 0.014</size></box></geometry>
          <material><ambient>0.80 0.02 0.02 1</ambient><diffuse>1.0 0.04 0.04 1</diffuse><emissive>0.28 0 0 1</emissive></material>
        </visual>
        <visual name="origin_y_axis">
          <pose>0 0.48 0.005 0 0 0</pose>
          <geometry><box><size>0.045 0.96 0.014</size></box></geometry>
          <material><ambient>0.02 0.65 0.06 1</ambient><diffuse>0.03 1.0 0.10 1</diffuse><emissive>0 0.24 0.02 1</emissive></material>
        </visual>
        <visual name="origin_center">
          <pose>0 0 0.010 0 0 0</pose>
          <geometry><cylinder><radius>0.105</radius><length>0.022</length></cylinder></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse><emissive>0.20 0.20 0.20 1</emissive></material>
        </visual>
      </link>
    </model>

    <model name="height_reference_visual">
      <static>true</static>
      <pose>2.0 -2.0 0 0 0 0</pose>
      <link name="link">
        <visual name="pole">
          <pose>0 0 2.75 0 0 0</pose>
          <geometry><cylinder><radius>0.018</radius><length>5.50</length></cylinder></geometry>
          <material><diffuse>1.0 0.85 0.05 1</diffuse></material>
        </visual>
        <visual name="tick_0_5m">
          <pose>0.12 0 0.5 0 0 0</pose>
          <geometry><box><size>0.24 0.025 0.025</size></box></geometry>
          <material><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
        <visual name="tick_1_0m">
          <pose>0.16 0 1.0 0 0 0</pose>
          <geometry><box><size>0.32 0.025 0.025</size></box></geometry>
          <material><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
        <visual name="tick_1_5m">
          <pose>0.12 0 1.5 0 0 0</pose>
          <geometry><box><size>0.24 0.025 0.025</size></box></geometry>
          <material><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
        <visual name="tick_2_0m">
          <pose>0.16 0 2.0 0 0 0</pose>
          <geometry><box><size>0.32 0.025 0.025</size></box></geometry>
          <material><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
        <visual name="tick_3_0m">
          <pose>0.16 0 3.0 0 0 0</pose>
          <geometry><box><size>0.32 0.025 0.025</size></box></geometry>
          <material><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
        <visual name="tick_4_0m">
          <pose>0.16 0 4.0 0 0 0</pose>
          <geometry><box><size>0.32 0.025 0.025</size></box></geometry>
          <material><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
        <visual name="tick_5_0m">
          <pose>0.16 0 5.0 0 0 0</pose>
          <geometry><box><size>0.32 0.025 0.025</size></box></geometry>
          <material><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://coaxial_uav</uri>
      <pose>0 0 0.34 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <static_publisher>false</static_publisher>
        <update_frequency>50</update_frequency>
      </plugin>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
      <plugin filename="libCoaxialPidController.so" name="coaxial_uav::CoaxialPidController">
        <enabled>false</enabled>
        <link_name>base_link</link_name>
        <upper_joint_name>upper_rotor_joint</upper_joint_name>
        <lower_joint_name>lower_rotor_joint</lower_joint_name>
        <mass_kg>8.2</mass_kg>
        <gravity_m_s2>9.8</gravity_m_s2>
        <thrust_coeff>2.1610671e-3</thrust_coeff>
        <rotor_interference_enabled>true</rotor_interference_enabled>
        <coaxial_max_thrust_loss>0.06</coaxial_max_thrust_loss>
        <target_z_m>0.8</target_z_m>
        <max_omega_rad_s>150.0</max_omega_rad_s>
        <attitude_setpoint_rate_limit_rad_s>0.75</attitude_setpoint_rate_limit_rad_s>
        <velocity_control_enabled>false</velocity_control_enabled>
        <target_vx_m_s>0.0</target_vx_m_s>
        <target_vy_m_s>0.0</target_vy_m_s>
        <velocity_tilt_limit_rad>0.261799</velocity_tilt_limit_rad>
        <velocity_accel_limit_m_s2>2.2</velocity_accel_limit_m_s2>
        <velocity_x_kp>2.8</velocity_x_kp>
        <velocity_x_ki>0.15</velocity_x_ki>
        <velocity_x_limit>2.2</velocity_x_limit>
        <velocity_x_integral_limit>1.0</velocity_x_integral_limit>
        <velocity_y_kp>2.8</velocity_y_kp>
        <velocity_y_ki>0.15</velocity_y_ki>
        <velocity_y_limit>2.2</velocity_y_limit>
        <velocity_y_integral_limit>1.0</velocity_y_integral_limit>
        <position_control_enabled>false</position_control_enabled>
        <target_x_m>0.0</target_x_m>
        <target_y_m>0.0</target_y_m>
        <position_velocity_limit_m_s>2.5</position_velocity_limit_m_s>
        <position_x_kp>2.5</position_x_kp>
        <position_x_ki>0.0</position_x_ki>
        <position_x_kd>0.95</position_x_kd>
        <position_x_limit>2.5</position_x_limit>
        <position_x_integral_limit>2.0</position_x_integral_limit>
        <position_y_kp>2.5</position_y_kp>
        <position_y_ki>0.0</position_y_ki>
        <position_y_kd>0.95</position_y_kd>
        <position_y_limit>2.5</position_y_limit>
        <position_y_integral_limit>2.0</position_y_integral_limit>
        <height_kp>45.0</height_kp>
        <height_ki>0.0</height_ki>
        <height_kd>35.0</height_kd>
        <height_limit>30.0</height_limit>
        <height_integral_limit>0.5</height_integral_limit>
        <roll_kp>193.3</roll_kp>
        <roll_kd>8.61</roll_kd>
        <roll_limit>2.5</roll_limit>
        <pitch_kp>351.3</pitch_kp>
        <pitch_kd>15.65</pitch_kd>
        <pitch_limit>2.7</pitch_limit>
        <yaw_kp>296.1</yaw_kp>
        <yaw_kd>13.19</yaw_kd>
        <yaw_limit>0.7</yaw_limit>
        <yaw_large_signal_kp>20.0</yaw_large_signal_kp>
        <yaw_large_signal_kd>3.0</yaw_large_signal_kd>
        <yaw_schedule_start_rad>0.02</yaw_schedule_start_rad>
        <yaw_schedule_end_rad>0.08</yaw_schedule_end_rad>
        <nonidealities_enabled>false</nonidealities_enabled>
        <attitude_noise_std_rad>0.000349066</attitude_noise_std_rad>
        <gyro_noise_std_rad_s>0.00174533</gyro_noise_std_rad_s>
        <attitude_bias_std_rad>0.000872665</attitude_bias_std_rad>
        <gyro_bias_std_rad_s>0.000872665</gyro_bias_std_rad_s>
        <position_noise_std_m>0.003</position_noise_std_m>
        <velocity_noise_std_m_s>0.01</velocity_noise_std_m_s>
        <control_delay_s>0.015</control_delay_s>
        <motor_time_constant_s>0.08</motor_time_constant_s>
        <motor_rate_limit_rad_s2>500.0</motor_rate_limit_rad_s2>
        <motor_effectiveness>0.98</motor_effectiveness>
        <nonidealities_seed>20260726</nonidealities_seed>
      </plugin>
      <plugin filename="libNearSurfaceDisturbance.so" name="coaxial_uav::NearSurfaceDisturbance">
        <enabled>false</enabled>
        <preset>off</preset>
        <link_name>base_link</link_name>
        <upper_joint_name>upper_rotor_joint</upper_joint_name>
        <lower_joint_name>lower_rotor_joint</lower_joint_name>
        <water_z_m>0.0</water_z_m>
        <rotor_radius_m>0.775</rotor_radius_m>
        <rotor_plane_offset_m>0.235</rotor_plane_offset_m>
        <thrust_coeff>2.1610671e-3</thrust_coeff>
        <full_effect_height_ratio>0.30</full_effect_height_ratio>
        <zero_effect_height_ratio>1.50</zero_effect_height_ratio>
        <minimum_rotor_omega_rad_s>20.0</minimum_rotor_omega_rad_s>
      </plugin>
      <plugin filename="libAerodynamicEnvironment.so" name="coaxial_uav::AerodynamicEnvironment">
        <enabled>false</enabled>
        <link_name>base_link</link_name>
        <upper_joint_name>upper_rotor_joint</upper_joint_name>
        <lower_joint_name>lower_rotor_joint</lower_joint_name>
        <air_density_kg_m3>1.225</air_density_kg_m3>
        <drag_area_x_m2>0.12</drag_area_x_m2>
        <drag_area_y_m2>0.18</drag_area_y_m2>
        <drag_area_z_m2>0.10</drag_area_z_m2>
        <angular_damping_roll_nm_s>0.12</angular_damping_roll_nm_s>
        <angular_damping_pitch_nm_s>0.18</angular_damping_pitch_nm_s>
        <angular_damping_yaw_nm_s>0.10</angular_damping_yaw_nm_s>
        <angular_damping_roll_quadratic>0.03</angular_damping_roll_quadratic>
        <angular_damping_pitch_quadratic>0.04</angular_damping_pitch_quadratic>
        <angular_damping_yaw_quadratic>0.02</angular_damping_yaw_quadratic>
        <nominal_mass_kg>8.2</nominal_mass_kg>
        <nominal_ixx>0.19588</nominal_ixx>
        <nominal_iyy>0.35588</nominal_iyy>
        <nominal_izz>0.30</nominal_izz>
        <thrust_coeff>2.1610671e-3</thrust_coeff>
      </plugin>
      <plugin filename="libCoaxialWaterInteraction.so" name="coaxial_uav::CoaxialWaterInteraction">
        <rotor_interference_enabled>true</rotor_interference_enabled>
        <hydrodynamics_enabled>true</hydrodynamics_enabled>
        <vehicle_mass_kg>8.2</vehicle_mass_kg>
        <link_name>base_link</link_name>
        <upper_joint_name>upper_rotor_joint</upper_joint_name>
        <lower_joint_name>lower_rotor_joint</lower_joint_name>
        <thrust_coeff>2.1610671e-3</thrust_coeff>
        <moment_constant>0.06478</moment_constant>
        <minimum_rotor_omega_rad_s>20.0</minimum_rotor_omega_rad_s>
        <coaxial_max_thrust_loss>0.06</coaxial_max_thrust_loss>
        <coaxial_inflow_time_constant_s>0.12</coaxial_inflow_time_constant_s>
        <water_density_kg_m3>997.0</water_density_kg_m3>
        <water_level_z_m>0.0</water_level_z_m>
        <float_virtual_draft_m>0.055</float_virtual_draft_m>
        <float_radius_m>0.09</float_radius_m>
        <float_length_m>1.10</float_length_m>
        <float_lateral_offset_m>0.34</float_lateral_offset_m>
        <float_vertical_offset_m>-0.24</float_vertical_offset_m>
        <float_count>2</float_count>
        <water_linear_drag_x_n_s_m>4.0</water_linear_drag_x_n_s_m>
        <water_linear_drag_y_n_s_m>35.0</water_linear_drag_y_n_s_m>
        <water_linear_drag_z_n_s_m>80.0</water_linear_drag_z_n_s_m>
        <water_quadratic_drag_x>0.25</water_quadratic_drag_x>
        <water_quadratic_drag_y>1.0</water_quadratic_drag_y>
        <water_quadratic_drag_z>1.1</water_quadratic_drag_z>
        <water_slamming_gain_n_s_m>35.0</water_slamming_gain_n_s_m>
        <max_hydrodynamic_force_n>220.0</max_hydrodynamic_force_n>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>coaxial_uav</robotNamespace>
        <jointName>upper_rotor_joint</jointName>
        <linkName>upper_rotor_link</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.075</timeConstantUp>
        <timeConstantDown>0.075</timeConstantDown>
        <maxRotVelocity>167.0</maxRotVelocity>
        <motorConstant>2.1610671e-3</motorConstant>
        <momentConstant>0.06478</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>0</actuator_number>
        <rotorDragCoefficient>0.0</rotorDragCoefficient>
        <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/upper</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>coaxial_uav</robotNamespace>
        <jointName>lower_rotor_joint</jointName>
        <linkName>lower_rotor_link</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.075</timeConstantUp>
        <timeConstantDown>0.075</timeConstantDown>
        <maxRotVelocity>167.0</maxRotVelocity>
        <motorConstant>2.1610671e-3</motorConstant>
        <momentConstant>0.06478</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>1</actuator_number>
        <rotorDragCoefficient>0.0</rotorDragCoefficient>
        <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/lower</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
    </include>
  </world>
</sdf>
